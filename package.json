{
  "name": "space",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "tauri": "tauri",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "tsc -b",
    "build:mac": "tauri build --bundles app && node scripts/package-macos.mjs",
    "package:mac": "node scripts/package-macos.mjs",
    "release:mac": "node scripts/release-macos.mjs",
    "test:release": "node --test scripts/*.check.mjs",
    "test:ui": "node scripts/catalog-ui.proof.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5",
    "@fontsource/ibm-plex-sans": "^5",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "lucide-react": "latest",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9",
    "vite": "^8",
    "vitest": "^4"
  },
  "packageManager": "pnpm@10.12.1"
}
