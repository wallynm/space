{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Space",
  "version": "0.5.5",
  "identifier": "studio.journey.folga",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Space · Espaço para respirar",
        "width": 1180,
        "height": 800,
        "minWidth": 840,
        "minHeight": 650,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "backgroundColor": "#f5f5ee"
      },
      {
        "label": "floating",
        "title": "Space",
        "url": "index.html#/floating",
        "width": 340,
        "height": 290,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "backgroundColor": "#153e35",
        "x": 1100,
        "y": 100
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Analise e recupere espaço em disco.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 210
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  }
}
